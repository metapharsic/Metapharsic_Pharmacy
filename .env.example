# ============================================================
# PharmaCare — Environment Variables Template
# Copy this file to .env.local and fill in the values
# ============================================================

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="PharmaCare"
NEXT_PUBLIC_APP_URL="http://localhost:5888"
PORT=5888
NODE_ENV="development"

# ─── Database ───────────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/pharmacare_dev?schema=public"
# For Prisma migrations
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/pharmacare_shadow?schema=public"

# ─── NextAuth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:5888"

# ─── Email (for password reset, notifications) ──────────────
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@pharmacare.local"

# ─── File Storage ───────────────────────────────────────────
# Local storage path (relative to project root)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB=10

# ─── Security ───────────────────────────────────────────────
# JWT secret for API tokens (if used outside NextAuth)
JWT_SECRET="your-jwt-secret-here"
BCRYPT_ROUNDS=12

# ─── Optional: Error Monitoring ─────────────────────────────
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ─── Optional: Analytics ────────────────────────────────────
# POSTHOG_KEY=

# ─── WhatsApp Automated Reports (11:30 PM Closing Digest) ───
# Provider options: auto | meta | twilio | ultramsg | simulation
WHATSAPP_PROVIDER="auto"
WHATSAPP_OWNER_PHONE="+919876543210"

# Option A: Meta WhatsApp Business Cloud API
# WHATSAPP_API_TOKEN="EAAB..."
# WHATSAPP_PHONE_NUMBER_ID="106..."

# Option B: Twilio Programmable WhatsApp
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="your-auth-token"
# TWILIO_WHATSAPP_FROM="+14155238886"

# Option C: UltraMsg Gateway
# ULTRAMSG_INSTANCE_ID="instance..."
# ULTRAMSG_TOKEN="your-ultramsg-token"
